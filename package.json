{
  "name": "soko",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5174",
    "build": "next build",
    "start": "next start",
    "db:migrate": "tsx scripts/prisma-cli.ts migrate dev",
    "db:deploy": "tsx scripts/prisma-cli.ts migrate deploy",
    "db:push": "tsx scripts/prisma-cli.ts db push",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "tsx scripts/prisma-cli.ts studio",
    "db:reset": "tsx scripts/prisma-cli.ts migrate reset --force",
    "db:synthetic-recovery": "tsx scripts/synthetic-recovery-demo.ts",
    "setup": "pnpm db:push && pnpm db:seed",
    "test": "node --import tsx scripts/run-tests.ts",
    "lh:mobile": "pnpm dlx lighthouse@latest http://localhost:5174/ --quiet --chrome-flags='--headless=new --no-sandbox' --only-categories=performance --view",
    "postinstall": "prisma generate",
    "lint": "eslint . --max-warnings=0",
    "i18n:check": "tsx scripts/i18n-audit.ts",
    "lint:fix": "eslint . --fix --max-warnings=0"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.4",
    "@prisma/client": "^6.2.1",
    "animejs": "^4.4.1",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "libphonenumber-js": "^1.13.16",
    "next": "^15.1.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.24",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "sharp": "^0.35.5",
    "stripe": "^17.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "sharp"
    ]
  }
}
