# Serveur joignable directement depuis Internet, avec un nom de domaine :
# HTTPS automatique (Let's Encrypt), Caddy obtient et renouvelle seul les certificats.
# Derrière le proxy d'Olga, c'est Caddyfile.olga qui sert (deploy/mvp.sh init-olga).
{
	email {$ACME_EMAIL}
	metrics
}

import /etc/caddy/common.caddy

{$DOMAIN} {
	import japora
}

grafana.{$DOMAIN} {
	import security_headers
	reverse_proxy grafana:3000
}

# Métriques internes pour Prometheus : ce port n'est pas publié.
:9180 {
	metrics /metrics
}
