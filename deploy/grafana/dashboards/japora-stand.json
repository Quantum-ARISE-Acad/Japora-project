   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m]))",
     "legendFormat": "Utilisé",
     "instant": false
    }
   ],
   "options": {}
  },
  {
