# Modèle de .env.mvp (rangé ici car .gitignore ignore les .env.*). Ne le copiez pas à la main : `deploy/mvp.sh init <domaine> <email>`
# crée .env.mvp et génère les secrets. .env.mvp n'est jamais commité.
DOMAIN=japora.example.com
ACME_EMAIL=info@quantum-arise.com
PUBLIC_URL=https://japora.example.com
GRAFANA_PUBLIC_URL=https://grafana.japora.example.com

POSTGRES_PASSWORD=
SESSION_SECRET=
WATARU_UNIFIED_AUTH_SECRET=
CRON_SECRET=
GRAFANA_ADMIN_PASSWORD=

# Propriétaire des fichiers de ./backups (uid:gid de l'utilisateur du serveur).
BACKUP_OWNER=0:0
BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP_DAYS=7

# Paiement simulé /dev/pay-stub : laisser vide tant que l'équipe n'a pas décidé.
# "1" permet à n'importe qui de marquer une commande payée.
JAPORA_ENABLE_DEV_PAY_STUB=

# Seulement pour tester sur une machine où 80 et 443 sont pris.
# CADDY_HTTP_PORT=8080
# CADDY_HTTPS_PORT=8443
