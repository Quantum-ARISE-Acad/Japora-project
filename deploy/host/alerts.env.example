# Alerte disque de la VM — copié dans /etc/japora/alerts.env (lisible par root seulement).
# Ne jamais mettre ce fichier rempli dans git.

# Destinataires (plusieurs : séparés par des virgules).
ALERT_EMAIL_TO="info@quantum-arise.com"
# Adresse d'envoi : celle du compte SMTP ci-dessous.
ALERT_EMAIL_FROM=""

# Serveur SMTP, en TLS. Exemples :
#   Gmail / Google Workspace : smtps://smtp.gmail.com:465   (mot de passe d'application)
#   Resend                  : smtps://smtp.resend.com:465  (utilisateur « resend », mot de passe = clé API)
SMTP_URL=""
SMTP_USER=""
SMTP_PASSWORD=""

# Seuils (en % d'espace utilisé) et rappel tant que le disque reste plein.
WARN_PCT=80
CRIT_PCT=90
REMIND_HOURS=12
