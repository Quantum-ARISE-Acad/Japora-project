# Copy to .env and fill in.

# Database — SQLite for local dev, Postgres for production.
# Use the same file Prisma manages under the schema directory.
DATABASE_URL="file:./prisma/dev.db"
# Postgres production options:
#   Supabase:  postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   Neon:      postgresql://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require
#   Railway:   postgresql://postgres:<password>@<host>.railway.app:5432/railway

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"

NEXT_PUBLIC_APP_URL="http://localhost:5174"

# ---------- Clerk Authentication (optional; fallback to demo accounts if empty) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""


# ---------- Object storage (optional) ----------
# Local uploads folder. Point it to a persistent folder (e.g. a Docker volume or
# a folder outside the build) so photos survive site updates. Default: ./public/uploads
UPLOADS_DIR=""
# Firebase Storage (first choice when set): uploads go to this bucket.
FIREBASE_STORAGE_BUCKET=""
FIREBASE_API_KEY=""
# Leave STORAGE_S3_BUCKET blank to keep saving uploads to UPLOADS_DIR
# (fine for a single Node host; broken on serverless).
# Set these to push to any S3-compatible storage — works with AWS S3,
# Cloudflare R2, and Supabase Storage by changing only the endpoint.
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="auto"
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
# Endpoint:
#   AWS S3:          leave blank (uses the regional default)
#   Cloudflare R2:   https://<account_id>.r2.cloudflarestorage.com
#   Supabase:        https://<project>.supabase.co/storage/v1/s3
STORAGE_S3_ENDPOINT=""
# Public URL prefix that uploaded files will be served from:
#   AWS S3:          https://<bucket>.s3.<region>.amazonaws.com
#   R2 (public):     https://pub-<hash>.r2.dev   (or your custom domain)
#   Supabase:        https://<project>.supabase.co/storage/v1/object/public/<bucket>
STORAGE_S3_PUBLIC_URL=""

# ---------- Email (optional) ----------
# Blank API key => stub provider (logs + persists to DB, no real send).
# EMAIL_FROM must use a Resend-verified domain.
RESEND_API_KEY=""
EMAIL_FROM="Japora <noreply@japora.market>"

# ---------- Stripe billing (optional) ----------
# Blank => /api/billing routes return 503, signup still creates 30-day trial.
# Install: pnpm add stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
NEXT_PUBLIC_STRIPE_PRICE_DISPLAY="$9/month"

# ---------- WhatsApp Cloud API (optional) ----------
# Blank token => built-in stub provider (messages logged + stored, not sent).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Numéro du bot (chiffres, ex. 22890000000) ouvert par les QR des boutiques ; vide = numéro du vendeur.
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=""
WHATSAPP_VERIFY_TOKEN="japora-verify-token"
# Meta App Secret for webhook signature verification (sha256). Blank => skipped.
WHATSAPP_APP_SECRET=""

# ---------- Japora: cron + payment rails + referrals ----------
# Shared secret used by Vercel Cron / external schedulers to call /api/cron/*.
CRON_SECRET=""

# ---------- FedaPay REST API v1 (Sandbox & Live) ----------
# "sandbox" pour les tests (sandbox-api.fedapay.com), "live" pour les vrais paiements (api.fedapay.com)
FEDAPAY_ENV="sandbox"
FEDAPAY_SANDBOX_PUBLIC_KEY="pk_sandbox_..."
FEDAPAY_SANDBOX_SECRET_KEY="sk_sandbox_..."
FEDAPAY_LIVE_PUBLIC_KEY="pk_live_..."
FEDAPAY_LIVE_SECRET_KEY="sk_live_..."
FEDAPAY_WEBHOOK_SECRET=""

# West Africa mobile money — legacy optional rails.
PAYGATE_AUTH_TOKEN=""
# CinetPay (Francophone W&C Africa): T-Money/Flooz/Orange/MoMo/Wave/card.
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""
CINETPAY_CHANNELS="MOBILE_MONEY"

# Paystack (NG/GH/KE/ZA).
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Flutterwave (pan-Africa).
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# M-Pesa Daraja (Safaricom).
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL=""

# WhatsApp Business Account ID — required for template + multi-tenant routing.
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Referral program tuning.
REFERRAL_REWARD_MONTHS="3"
REFERRAL_QUALIFY_THRESHOLD="3"

# ---------- Bot AI layer (optional) ----------
# Blank => keyword bot only. Present => open questions get catalog-grounded answers.
GEMINI_API_KEY=""           # assistant, voice notes, photo search (Google AI Studio)
ANTHROPIC_API_KEY=""        # other provider (claude-3-5-haiku-latest)
OPENAI_API_KEY=""           # other provider (gpt-4o-mini)
JAPORA_LLM_MODEL=""         # override model id (optional)
JAPORA_LLM_DAILY_CAP_PER_VENDOR="200"  # per-vendor daily LLM call cap
JAPORA_FREE_BROADCAST_RECIPIENTS="200" # free marketing-broadcast recipients/vendor/month

# ---------- Rate limits (per hour for sign-up, per 15 min for login, per IP/visitor) ----------
# Defaults: 3 sign-ups/hour, 5 logins/15 min. Raise them for a fair / shared Wi-Fi (e.g. 500).
SIGNUP_RATE_LIMIT=""
LOGIN_RATE_LIMIT=""
# Public shop traffic (per IP/visitor): orders per 5 min, follows/QR/analytics/checkout per minute.
# Defaults 10 / 20 / 60 / 120 / 10 — raise them (e.g. 500) when many people share one Wi-Fi.
ORDER_RATE_LIMIT=""
FOLLOW_RATE_LIMIT=""
QR_RATE_LIMIT=""
BEACON_RATE_LIMIT=""
CHECKOUT_RATE_LIMIT=""

# ---------- Phone (WhatsApp OTP) sign-up ----------
# Off until the WhatsApp line that sends the code is connected. Set to 1 to enable /start.
JAPORA_ENABLE_PHONE_SIGNUP=""

# ---------- Dev only ----------
# Enables the credential-free /dev/pay-stub demo payment flow. Never set in prod.
JAPORA_ENABLE_DEV_PAY_STUB=""

# ---------- WASpine event bus (optional) ----------
# Japora publishes catalog.product.published / .updated, catalog.price.changed
# and catalog.stock.depleted to the spine. Blank => the facts are still recorded
# in the BusEvent outbox and nothing is sent; the backlog shows on /api/health
# and in the maintenance cron's report, so an unconfigured bus is visible rather
# than silent.
#
# The token is minted per process by the spine at startup
# (`python3 WASpine/api.py` prints one per product) — configuration, never
# committed. Leave it blank here.
SPINE_URL=""
SPINE_PRODUCT_ID="wcatalog"
SPINE_PRODUCT_TOKEN=""

# Article VII.4 killswitch. "1" stops the outbox from sending, without a deploy.
# The facts are still written down: the switch stops the product, it does not
# erase what happened while it was down.
WA_WCATALOG_DISABLED=""

# Soko catalog synchronization (same strong random secret in both services)
SOKO_API_URL=http://localhost:4000
SOKO_SYNC_SECRET=

# Optional: tolerated clock drift (ms) when verifying Clerk session tokens.
# Defaults to 600000 in development; unset (Clerk default 5s) in production.
# CLERK_CLOCK_SKEW_MS=
